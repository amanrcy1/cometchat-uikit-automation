{
  "name": "cometchat-uikit-automation",
  "version": "1.0.0",
  "description": "Future-proof QA framework for CometChat UIKit — UI, API, and Integration tests",
  "scripts": {
    "test": "npx playwright test",
    "test:headed": "npx playwright test --headed",
    "test:ui": "npx playwright test tests/ui/",
    "test:api": "npx playwright test tests/api/",
    "test:integration": "npx playwright test tests/integration/",
    "test:smoke": "npx playwright test --grep @smoke",
    "test:sanity": "npx playwright test --grep @sanity",
    "test:regression": "npx playwright test",
    "test:chat": "npx playwright test --grep @chat",
    "test:group": "npx playwright test --grep @group",
    "test:calls": "npx playwright test --grep @calls",
    "test:composer": "npx playwright test --grep @composer",
    "test:media": "npx playwright test --grep @media",
    "test:thread": "npx playwright test --grep @thread",
    "test:search": "npx playwright test --grep @search",
    "test:auth": "npx playwright test --grep @auth",
    "test:admin": "npx playwright test --grep @admin",
    "test:details": "npx playwright test --grep @details",
    "test:visual": "npx playwright test --grep @visual",
    "test:a11y": "npx playwright test --grep @a11y",
    "test:negative": "npx playwright test --grep @negative",
    "test:network": "npx playwright test --grep @network",
    "test:network:headed": "npx playwright test tests/ui/network.spec.ts --headed",
    "test:skip-visual": "npx playwright test --grep-invert @visual",
    "report": "npx playwright show-report",
    "linear": "npx ts-node lib/reporters/linear-reporter.ts",
    "linear:teams": "npx ts-node lib/reporters/linear-reporter.ts --teams",
    "perf:smoke": "k6 run --env SCENARIO=smoke perf/chat-load-test.js",
    "perf:average": "k6 run --env SCENARIO=average perf/chat-load-test.js",
    "perf:stress": "k6 run --env SCENARIO=stress perf/chat-load-test.js",
    "perf:spike": "k6 run --env SCENARIO=spike perf/chat-load-test.js",
    "perf:soak": "k6 run --env SCENARIO=soak perf/chat-load-test.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^25.3.2",
    "dotenv": "^16.4.7",
    "typescript": "^5.9.3"
  }
}
